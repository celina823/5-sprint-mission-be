// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id                Int      @id @default(autoincrement())
  email             String   @unique
  nickname          String
  image             String
  encryptedPassword String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  articles Articles[] // User:Article 1:N
  products Products[]
  comments Comments[]
  Favorite Favorites[]
}

model Articles {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  image     String
  // likeCount controller파일에 추가 prisma.favorite.count()
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  writerId Int // ✅ Article에 User ID 저장
  writer   Users       @relation(fields: [writerId], references: [id])
  Favorite Favorites[]
}

model Products {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  price       Int
  isFavorite  Boolean

  tags   Tags[] // Product:Tag 1:N
  images Images[] // Product:Image 1:N

  ownerId   Int
  // favoriteCount controller파일에 추가 prisma.favorite.count()
  createdAt DateTime @default(now())

  owner    Users       @relation(fields: [ownerId], references: [id])
  comments Comments[] // Product:Comment 1:N
  Favorite Favorites[] // Product:Favorite 1:N
}

model Tags {
  id        Int      @id @default(autoincrement())
  name      String
  productId Int // ✅ Foreign Key
  product   Products @relation(fields: [productId], references: [id])
}

model Images {
  id        Int      @id @default(autoincrement())
  url       String
  productId Int // ✅ Foreign Key
  product   Products @relation(fields: [productId], references: [id])
}

model Comments {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   Users @relation(fields: [userId], references: [id])

  productId Int
  product   Products @relation(fields: [productId], references: [id])
}

model Favorites {
  id        String   @id @default(uuid())
  userId    Int
  productId Int?
  articleId Int?
  createdAt DateTime @default(now())

  user    Users     @relation(fields: [userId], references: [id])
  product Products? @relation(fields: [productId], references: [id])
  article Articles? @relation(fields: [articleId], references: [id])

  @@unique([userId, productId, articleId])
}
